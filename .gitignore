/docs/private/
*.p12
*.pfx
*.tfstate
*.tfstate.*
credentials.json
secrets.json

# Local editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.zip
*.jsonl

# Binary reports/screenshots: retain Markdown reports in the repository.
/docs/report/*.png
/docs/report/*.jpg
/docs/report/*.jpeg
/docs/report/*.pdf
/docs/report/*.docx
~$*
