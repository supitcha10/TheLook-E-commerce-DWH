# Data stays outside Git; keep acquisition instructions.
/dataset/*
!/dataset/README.md
/outputs/
*.parquet

# Local Python/runtime files
/.runtime_dependencies/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Credentials and machine/account-specific configuration
.env
.env.*
!.env.example
.aws/
/code/aws_batch_config.json
/code/aws_batch_config.local*.json
*.pem
*.key
# The reviewed handoff and Markdown evidence are part of the deliverable.
